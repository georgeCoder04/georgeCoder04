  "narrative": {
    "northStar": "The Coastal Field Console",
    "overview": "Vice Desk presents as a sunlit dispatch object: an atlas, mission brief, and field notebook held together by a disciplined interface. Warm paper, Atlantic green, and coral produce a coastal identity without relying on protected game assets or generic neon gaming language. Familiar controls, hard edges, and restrained depth let players act quickly.",
    "keyCharacteristics": ["Original vector cartography is the primary visual and interaction surface.", "Warm paper fields support tactical data rather than replacing it with decoration.", "Coral marks action and current state; green anchors navigation and structure.", "Nearly every strong surface is rectangular, outlined, and instrument-like."],
    "rules": [
      { "name": "The Useful Signal Rule", "body": "Accent color must identify action, selection, or status; it is not a decorative glow or filler.", "section": "colors" },
      { "name": "The No Costume Type Rule", "body": "Condensed type is used for data and controls, never as decorative technical copy at display scale.", "section": "typography" }
    ],
    "dos": ["Do make the map the dominant shared workspace on planning surfaces.", "Do label the experience unofficial, synthetic, and disconnected from a live game."],
    "donts": ["Don't use protected logos, exact game assets, external artwork, or live-service claims.", "Don't add dark-neon glow, glass surfaces, or gradient text."]
